DATABASE_URL="postgresql://lagoinha:change-me-local@localhost:5432/lagoinha?schema=public"
POSTGRES_USER=lagoinha
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=lagoinha
# Para docker compose, DATABASE_URL é configurada apontando para o serviço db.
# Defina somente no ambiente para criar o primeiro admin:
# ADMIN_EMAIL=admin@exemplo.com
# ADMIN_PASSWORD=escolha-uma-senha-forte
