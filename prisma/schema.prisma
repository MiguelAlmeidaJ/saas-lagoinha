generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PASTOR
  FINANCEIRO
  COORDENADOR
  LIDER_GC
  VOLUNTARIO
  MEMBRO
}

model Church {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  slug      String       @unique
  createdAt DateTime     @default(now())
  members   Membership[]
  people    Person[]
  ministries Ministry[]
  auditLogs AuditLog[]
  serviceEvents ServiceEvent[]
  teamMembers TeamMember[]
  ministryFunctions MinistryFunction[]
  scheduleAssignments ScheduleAssignment[]
  unavailabilities Unavailability[]
  coordinators MinistryCoordinator[]
  swapRequests SwapRequest[]
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  email        String       @unique
  passwordHash String
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  sessions     Session[]
  person       Person?
  coordinatedMinistries MinistryCoordinator[]
  requestedSwaps SwapRequest[]
}

model Membership {
  churchId  String  @db.Uuid
  userId    String  @db.Uuid
  role      Role    @default(MEMBRO)
  church    Church  @relation(fields: [churchId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([churchId, userId])
  @@index([userId])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model Person {
  id        String   @id @default(uuid()) @db.Uuid
  churchId  String   @db.Uuid
  fullName  String   @db.VarChar(160)
  email     String?  @db.VarChar(254)
  phone     String?  @db.VarChar(30)
  createdAt DateTime @default(now())
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  userId    String?  @unique @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  teamMemberships TeamMember[]
  scheduleAssignments ScheduleAssignment[]
  unavailabilities Unavailability[]
  @@unique([churchId, id])
  @@index([churchId, fullName])
}

model Ministry {
  id          String   @id @default(uuid()) @db.Uuid
  churchId    String   @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  church      Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  teamMembers TeamMember[]
  functions MinistryFunction[]
  events ServiceEvent[]
  assignments ScheduleAssignment[]
  coordinators MinistryCoordinator[]
  swapRequests SwapRequest[]
  @@unique([churchId, id])
  @@unique([churchId, name])
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  churchId   String   @db.Uuid
  actorId    String?  @db.Uuid
  entityType String
  entityId   String   @db.Uuid
  operation  String
  createdAt  DateTime @default(now())
  church     Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  @@index([churchId, createdAt])
}

enum AssignmentStatus {
  PENDENTE
  CONFIRMADA
  RECUSADA
}

model TeamMember {
  id         String   @id @default(uuid()) @db.Uuid
  churchId   String   @db.Uuid
  ministryId String   @db.Uuid
  personId   String   @db.Uuid
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  church     Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  ministry   Ministry @relation(fields: [churchId, ministryId], references: [churchId, id], onDelete: Cascade)
  person     Person   @relation(fields: [churchId, personId], references: [churchId, id], onDelete: Cascade)
  @@unique([churchId, ministryId, personId])
  @@index([churchId, personId])
}

model MinistryFunction {
  id         String   @id @default(uuid()) @db.Uuid
  churchId   String   @db.Uuid
  ministryId String   @db.Uuid
  name       String   @db.VarChar(100)
  church     Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  ministry   Ministry @relation(fields: [churchId, ministryId], references: [churchId, id], onDelete: Cascade)
  assignments ScheduleAssignment[]
  @@unique([churchId, id])
  @@unique([churchId, ministryId, name])
  @@index([churchId, ministryId])
}

model ServiceEvent {
  id          String   @id @default(uuid()) @db.Uuid
  churchId    String   @db.Uuid
  ministryId  String   @db.Uuid
  title       String   @db.VarChar(160)
  startsAt    DateTime
  endsAt      DateTime
  location    String?  @db.VarChar(160)
  createdAt   DateTime @default(now())
  church      Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  ministry    Ministry @relation(fields: [churchId, ministryId], references: [churchId, id], onDelete: Cascade)
  assignments ScheduleAssignment[]
  @@unique([churchId, id])
  @@index([churchId, startsAt])
  @@index([churchId, ministryId])
}

model ScheduleAssignment {
  id          String @id @default(uuid()) @db.Uuid
  churchId    String @db.Uuid
  ministryId  String @db.Uuid
  eventId     String @db.Uuid
  personId    String @db.Uuid
  functionId  String? @db.Uuid
  status      AssignmentStatus @default(PENDENTE)
  respondedAt DateTime?
  createdAt   DateTime @default(now())
  church      Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  ministry    Ministry @relation(fields: [churchId, ministryId], references: [churchId, id], onDelete: Cascade)
  event       ServiceEvent @relation(fields: [churchId, eventId], references: [churchId, id], onDelete: Cascade)
  person      Person @relation(fields: [churchId, personId], references: [churchId, id], onDelete: Cascade)
  function    MinistryFunction? @relation(fields: [churchId, functionId], references: [churchId, id], onDelete: Restrict)
  swapRequests SwapRequest[]
  @@unique([churchId, id])
  @@unique([churchId, eventId, personId])
  @@index([churchId, personId])
}

model Unavailability {
  id        String @id @default(uuid()) @db.Uuid
  churchId  String @db.Uuid
  personId  String @db.Uuid
  startsAt  DateTime
  endsAt    DateTime
  reason    String? @db.VarChar(250)
  church    Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  person    Person @relation(fields: [churchId, personId], references: [churchId, id], onDelete: Cascade)
  @@index([churchId, personId, startsAt])
}

enum SwapRequestStatus {
  PENDENTE
  APROVADA
  RECUSADA
  CANCELADA
}

model MinistryCoordinator {
  id         String   @id @default(uuid()) @db.Uuid
  churchId   String   @db.Uuid
  ministryId String   @db.Uuid
  userId     String   @db.Uuid
  createdAt  DateTime @default(now())
  church     Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  ministry   Ministry @relation(fields: [churchId, ministryId], references: [churchId, id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([churchId, ministryId, userId])
  @@index([churchId, userId])
}

model SwapRequest {
  id           String            @id @default(uuid()) @db.Uuid
  churchId     String            @db.Uuid
  ministryId   String            @db.Uuid
  assignmentId String            @db.Uuid
  requesterId  String            @db.Uuid
  reason       String?           @db.VarChar(500)
  status       SwapRequestStatus @default(PENDENTE)
  createdAt    DateTime          @default(now())
  resolvedAt   DateTime?
  resolvedById String?           @db.Uuid
  church       Church            @relation(fields: [churchId], references: [id], onDelete: Cascade)
  ministry     Ministry          @relation(fields: [churchId, ministryId], references: [churchId, id], onDelete: Cascade)
  assignment   ScheduleAssignment @relation(fields: [churchId, assignmentId], references: [churchId, id], onDelete: Cascade)
  requester    User              @relation(fields: [requesterId], references: [id], onDelete: Restrict)
  @@index([churchId, ministryId, status])
  @@index([churchId, requesterId])
}
